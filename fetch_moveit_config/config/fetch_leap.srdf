<?xml version="1.0" ?>
<robot name="fetch">
    <!-- Planning groups -->
    <group name="arm">
        <joint name="shoulder_pan_joint" />
        <joint name="shoulder_lift_joint" />
        <joint name="upperarm_roll_joint" />
        <joint name="elbow_flex_joint" />
        <joint name="forearm_roll_joint" />
        <joint name="wrist_flex_joint" />
        <joint name="wrist_roll_joint" />
    </group>

    <group name="arm_with_torso">
        <joint name="torso_lift_joint" />
        <joint name="shoulder_pan_joint" />
        <joint name="shoulder_lift_joint" />
        <joint name="upperarm_roll_joint" />
        <joint name="elbow_flex_joint" />
        <joint name="forearm_roll_joint" />
        <joint name="wrist_flex_joint" />
        <joint name="wrist_roll_joint" />
    </group>

    <group name="leap_hand">
        <link name="ati_link" />
        <link name="palm_lower" />
        <!-- Index Finger -->
        <joint name="joint_0" />
        <joint name="joint_1" />
        <joint name="joint_2" />
        <joint name="joint_3" />
        <!-- Middle Finger -->
        <joint name="joint_4" />
        <joint name="joint_5" />
        <joint name="joint_6" />
        <joint name="joint_7" />
        <!-- Ring Finger -->
        <joint name="joint_8" />
        <joint name="joint_9" />
        <joint name="joint_10" />
        <joint name="joint_11" />
        <!-- Thumb -->
        <joint name="joint_12" />
        <joint name="joint_13" />
        <joint name="joint_14" />
        <joint name="joint_15" />
    </group>

    <group name="leap_index">
        <joint name="joint_0" />
        <joint name="joint_1" />
        <joint name="joint_2" />
        <joint name="joint_3" />
    </group>

    <group name="leap_middle">
        <joint name="joint_4" />
        <joint name="joint_5" />
        <joint name="joint_6" />
        <joint name="joint_7" />
    </group>

    <group name="leap_ring">
        <joint name="joint_8" />
        <joint name="joint_9" />
        <joint name="joint_10" />
        <joint name="joint_11" />
    </group>

    <group name="leap_thumb">
        <joint name="joint_12" />
        <joint name="joint_13" />
        <joint name="joint_14" />
        <joint name="joint_15" />
    </group>

    <!-- Group States (Poses) -->
    <group_state name="open_hand" group="leap_hand">
        <joint name="joint_0" value="0.0" />
        <joint name="joint_1" value="0.0" />
        <joint name="joint_2" value="0.0" />
        <joint name="joint_3" value="0.0" />
        <joint name="joint_4" value="0.0" />
        <joint name="joint_5" value="0.0" />
        <joint name="joint_6" value="0.0" />
        <joint name="joint_7" value="0.0" />
        <joint name="joint_8" value="0.0" />
        <joint name="joint_9" value="0.0" />
        <joint name="joint_10" value="0.0" />
        <joint name="joint_11" value="0.0" />
        <joint name="joint_12" value="0.0" />
        <joint name="joint_13" value="0.0" />
        <joint name="joint_14" value="0.0" />
        <joint name="joint_15" value="0.0" />
    </group_state>

    <group_state name="close_hand" group="leap_hand">
        <joint name="joint_0" value="0.0" />
        <joint name="joint_1" value="1.2" />
        <joint name="joint_2" value="1.2" />
        <joint name="joint_3" value="0.8" />
        <joint name="joint_4" value="0.0" />
        <joint name="joint_5" value="1.2" />
        <joint name="joint_6" value="1.2" />
        <joint name="joint_7" value="0.8" />
        <joint name="joint_8" value="0.0" />
        <joint name="joint_9" value="1.2" />
        <joint name="joint_10" value="1.2" />
        <joint name="joint_11" value="0.8" />
        <joint name="joint_12" value="1.0" />
        <joint name="joint_13" value="1.0" />
        <joint name="joint_14" value="1.0" />
        <joint name="joint_15" value="0.5" />
    </group_state>

    <!-- End Effector -->
    <end_effector name="leap_hand" parent_link="wrist_roll_link" group="leap_hand" parent_group="arm" />

    <!-- Disable Collisions: Base robot links (from fetch.srdf) -->
    <disable_collisions link1="base_link" link2="bellows_link" reason="Default" />
    <disable_collisions link1="base_link" link2="bellows_link2" reason="Default" />
    <disable_collisions link1="base_link" link2="estop_link" reason="Adjacent" />
